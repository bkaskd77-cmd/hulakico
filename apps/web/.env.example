# Hulakico web (apps/web) — copy to .env.local and fill values.
# Never commit real secrets.

# Local auth DB (Node built-in SQLite; production target remains PostgreSQL)
DATABASE_PATH="./data/hulakico.db"

# Future production Postgres (not required for Step 3 local)
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hulakico"

# Session / auth secrets
AUTH_SECRET="replace-with-long-random-string"

# Python intelligence service (Step 2 / 7+)
INTELLIGENCE_API_URL="http://127.0.0.1:8000"
INTELLIGENCE_SERVICE_TOKEN="hulakico-dev-intelligence-token"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Promote this signed-up email to OPS on DB boot (Phase 2 role gates)
OPS_BOOTSTRAP_EMAIL="you@example.com"
