# Hulakico site for the shared Caddy. Install as
# /etc/caddy/sites-available/hulakico.caddy and link it into sites-enabled.
# Caddy gets the HTTPS certificate once DNS for both names points at this VPS.

www.hulakico.com {
	redir https://hulakico.com{uri} permanent
}

hulakico.com {
	# DNS is proxied by Cloudflare. Refuse requests that skip it
	# (ranges from https://www.cloudflare.com/ips).
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/32 ::1/128
	respond @not_cloudflare 403

	request_body {
		max_size 10MB
	}
	encode zstd gzip
	header -Server

	reverse_proxy 127.0.0.1:3201 {
		# Only Cloudflare reaches this point, so its visitor IP header is trustworthy.
		# The app's rate limiter reads the first X-Forwarded-For value.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		lb_try_duration 5s
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
